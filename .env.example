# Copy this file to `.env` and fill in your own key.
# `.env` is git-ignored -- never commit real credentials.

# Default provider: Anthropic (Claude Opus 4.8).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter: ONE key for the open models -- DeepSeek, Kimi K2, GLM-4.6, Qwen,
# Llama. Far cheaper than a frontier API. Use it for development and for the
# open-vs-proprietary comparison; reserve Anthropic for headline runs.
#   provider="openrouter", model="moonshotai/kimi-k2" | "z-ai/glm-4.6"
#                                 | "deepseek/deepseek-chat" | "qwen/qwen-2.5-72b-instruct"
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional alternatives, only needed if you pass --provider openai / groq.
OPENAI_API_KEY=sk-proj-your-key-here
GROQ_API_KEY=gsk_your-key-here
